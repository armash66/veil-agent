# ─────────────────────────────────────
# REASONING PROVIDER (gemini | openrouter | openai | ollama | mock)
# ─────────────────────────────────────
REASONING_PROVIDER=openrouter

# ─────────────────────────────────────
# GEMINI
# ─────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────
# OPENROUTER
# ─────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ─────────────────────────────────────
# OPENAI / OLLAMA
# ─────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Agent settings
WEBVEIL_MAX_STEPS=20
WEBVEIL_MAX_ACTIONS_PER_PLAN=5
WEBVEIL_HEADLESS=false

# Dashboard
WEBVEIL_DASHBOARD_PORT=9090

# OCR (set to false to disable even if tesseract is installed)
WEBVEIL_OCR_ENABLED=true
