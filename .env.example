# WebVeil Configuration
# Copy this file to .env and fill in your values

# Reasoning provider: gemini | openai | ollama | mock
WEBVEIL_PROVIDER=gemini

# API keys (only needed for the provider you choose)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Ollama settings (only if WEBVEIL_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Gemini model (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# OpenAI model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Agent settings
WEBVEIL_MAX_STEPS=20
WEBVEIL_MAX_ACTIONS_PER_PLAN=5
WEBVEIL_HEADLESS=false

# Dashboard
WEBVEIL_DASHBOARD_PORT=9090

# OCR (set to false to disable even if tesseract is installed)
WEBVEIL_OCR_ENABLED=true
